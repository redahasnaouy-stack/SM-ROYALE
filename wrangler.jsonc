{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velora",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "velora-db",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "keep_vars": true
}
